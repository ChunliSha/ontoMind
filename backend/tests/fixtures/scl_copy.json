        "extension_id": "operation_node_20251126_f5b8c2",
        "type": "业务操作",
        "properties": {
          "name": "主站侧日志是否完整",
          "description": "检查主站侧日志是否完整，即检查是否已完整导入数据冻结时间当天及下一天的来自主站或低压集抄APP的日志",
          "relatedDevice": "主站",
          "step1Type": "接口调用",
          "interfaceName": "检查主站日志完整性",
          "requestMethod": "POST",
          "requestPath": "/api/v1/query_master_logs_complete",
          "requestParams": "无",
          "responseParams": "response_info:\n     type: json\n     required: true\n     description: 主站日志是否完整，key值为主站日志，value值为完整或不完整",
          "userGuideContent": "",
          "step1Analysis": "主站侧日志可以来源于主站或低压集抄APP，一般要求有T和T+1的两天日志，这样指标采集状态和分析结果会更准确。另外，每天0-1点和19-24点不一定有主站侧日志，所以这两段时间若无日志，也会视为完整",
          "judgementContent": "判断主站侧日志是否导入完整，若不完整，则最终诊断结果可能不完全准确",
          "selectedObjectId": "自定义",
          "relatedDevice_id": "79d82c1e-5bd4-42b7-9c97-25fca5c84541"
        }
      },
