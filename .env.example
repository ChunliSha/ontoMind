# OntoMind 环境变量模板（对应开发指导文档 §14）
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不要提交。

# ---------- 数据库 ----------
# 远程 PostgreSQL 16，本地直连；SQLAlchemy async 驱动前缀为 postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ontomind

# ---------- 密钥 ----------
# data_source_db.password_enc 的 Fernet 对称加密密钥
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_SECRET_KEY=

# ---------- 文件存储 ----------
LOCAL_STORAGE_ROOT=./data/uploads
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ontomind

# ---------- AI ----------
# openai_compatible（需配置 LLM_API_BASE，或在「模型管理」中添加模型）
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
