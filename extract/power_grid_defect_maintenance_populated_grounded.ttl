:Person a owl:Class ;
    rdfs:label "人员"@zh .

:MaintenanceOrder a owl:Class ;
    rdfs:label "检修工单"@zh ;
    rdfs:comment "针对某一缺陷或设备发起的检修/消缺任务。"@zh .

:InspectionRecord a owl:Class ;
    rdfs:label "巡检记录"@zh ;
    rdfs:comment "运维人员对设备进行例行或专项巡视的记录。"@zh .

